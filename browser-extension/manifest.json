{
  "manifest_version": 3,
  "name": "psst Passkeys",
  "version": "0.1.0",
  "description": "Completes WebAuthn assertions authorized by a psst session.",
  "minimum_chrome_version": "102",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["relay.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://*/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
