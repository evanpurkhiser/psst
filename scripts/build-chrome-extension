#!/usr/bin/env bash

set -euo pipefail

if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo "usage: $0 <private-key.pem> [output.crx]" >&2
  exit 2
fi

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
PRIVATE_KEY=$1
OUTPUT=${2:-"${ROOT}/target/psst-chrome-extension.crx"}
CHROME_BIN=${CHROME_BIN:-google-chrome-stable}

if [[ ! -f "$PRIVATE_KEY" ]]; then
  echo "Chrome extension private key not found: ${PRIVATE_KEY}" >&2
  exit 1
fi

command -v "$CHROME_BIN" >/dev/null
command -v openssl >/dev/null
command -v python3 >/dev/null

PUBLIC_KEY=$(openssl rsa -in "$PRIVATE_KEY" -pubout -outform DER 2>/dev/null | base64 -w0)
python3 - "$ROOT" "$PUBLIC_KEY" <<'PY'
import json
import pathlib
import sys
import tomllib

root = pathlib.Path(sys.argv[1])
public_key = sys.argv[2]
manifest = json.loads((root / "browser-extension/manifest.json").read_text())
package = tomllib.loads((root / "Cargo.toml").read_text())["package"]

if manifest["key"] != public_key:
    raise SystemExit("manifest key does not match the signing key")

if manifest["version"] != package["version"]:
    raise SystemExit("extension and package versions do not match")
PY

BUILD_DIR=$(mktemp -d)
trap 'rm -rf "$BUILD_DIR"' EXIT
cp -R "$ROOT/browser-extension" "$BUILD_DIR/extension"

"$CHROME_BIN" \
  --no-sandbox \
  --pack-extension="$BUILD_DIR/extension" \
  --pack-extension-key="$PRIVATE_KEY"

install -Dm644 "$BUILD_DIR/extension.crx" "$OUTPUT"
echo "$OUTPUT"
