{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "psst",
  "private": true,
  "license": "MIT",
  "author": "Evan Purkhiser",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-browser-extension.mjs",
    "build-release": "node scripts/build-browser-extension.mjs --release",
    "format": "oxfmt .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "vanjs-core": "^1.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@evanpurkhiser/oxc-config": "^0.19.0",
    "@types/chrome": "^0.3.7",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1"
    },
    "runtime": {
      "name": "node",
      "version": "^24.15.0"
    }
  }
}
